# Server
PORT=3001
NODE_ENV=development

# JWT Secret - change this in production!
JWT_SECRET=pdesign-dev-secret-change-in-production

# Client URL (for CORS and magic link URLs)
CLIENT_URL=http://localhost:5173

# Anthropic API Key (leave empty to use demo flow)
ANTHROPIC_API_KEY=

# Stripe (leave empty for mock responses)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
